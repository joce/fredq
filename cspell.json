{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  "useGitignore": true,
  "ignorePaths": [
    ".git",
    ".gitignore",
    ".pytest_cache",
    ".ruff_cache",
    ".tox",
    ".uv-cache",
    ".venv",
    "cspell.json",
    "htmlcov",
    "Makefile",
    "node_modules",
    "pyproject.toml",
    "tox.ini",
    "uv.lock"
  ],
  "files": [
    "**/*.{md,py,toml,json,yml,yaml,ps1}"
  ],
  "dictionaries": ["python"],
  "ignoreWords": [
    "alfred",
    "censusdivision",
    "censusregion",
    "delenv",
    "edgarq",
    "fredq",
    "geofred",
    "homebuilder",
    "necta",
    "posargs",
    "pyfredapi",
    "pystlouisfed",
    "seriess",
    "testpaths",
    "topojson",
    "unparseable"
  ],
  "words": [
    "ACMR",
    "capsys",
    "jocelynlegault",
    "joce",
    "Legault",
    "stlouisfed",
    "vintagedates"
  ],
  "patterns": [
    {
      "name": "fred_series_id",
      "pattern": "/\\b[A-Z][A-Z0-9]{2,}\\b/"
    }
  ],
  "ignoreRegExpList": ["fred_series_id"]
}
