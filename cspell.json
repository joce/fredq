{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  "useGitignore": true,
  "ignorePaths": [
    "**/__marimo__",
    ".git",
    ".gitignore",
    ".pytest_cache",
    ".ruff_cache",
    ".tox",
    ".uv-cache",
    ".venv",
    "cspell.json",
    "htmlcov",
    "Makefile",
    "node_modules",
    "pyproject.toml",
    "tests/fixtures/corpus/**/*.json",
    "tox.ini",
    "uv.lock"
  ],
  "files": [
    "**/*.{md,py,toml,json,yml,yaml,ps1}"
  ],
  "dictionaries": ["python"],
  "ignoreWords": [
    "alfred",
    "badmethod",
    "bannual",
    "delenv",
    "edgarq",
    "fredq",
    "geofred",
    "geot",
    "homebuilder",
    "posargs",
    "pyfredapi",
    "pystlouisfed",
    "realtime",
    "rls",
    "seas",
    "seriess",
    "testpaths",
    "topsecret",
    "unparseable"
  ],
  "words": [
    "ACMR",
    "autouse",
    "backtests",
    "caplog",
    "capsys",
    "coro",
    "CPIAUCSL",
    "datetimes",
    "DEXCAUS",
    "dogfood",
    "dogfooding",
    "dunders",
    "FEDFUNDS",
    "foundish",
    "FUNCS",
    "GNPCA",
    "groupp",
    "intraday",
    "kwarg",
    "logreport",
    "longrepr",
    "metavar",
    "metavars",
    "nbsp",
    "jocelynlegault",
    "joce",
    "Legault",
    "monkeypatched",
    "nodeid",
    "padder",
    "reprs",
    "reraises",
    "sdists",
    "stlouisfed",
    "ungated",
    "unmodeled",
    "unpivot",
    "vintagedates",
    "wasxfail",
    "worktree",
    "xhigh",
    "zzqqxbogustag",
    "zzxqqzyxnonsense"
  ],
  "patterns": [
    {
      "name": "fred_series_id",
      "pattern": "/\\b[A-Z][A-Z0-9]{2,}\\b/"
    }
  ],
  "ignoreRegExpList": ["fred_series_id"]
}
